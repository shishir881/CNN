
import cv2
import numpy as np
import matplotlib.pyplot as plt
from ultralytics import YOLO
from tkinter import Tk, filedialog

class LowLightEnhancer:
    def __init__(self, clip_limit=3.0, tile_grid_size=(8, 8)):
        self.clahe = cv2.createCLAHE(clipLimit=clip_limit, tileGridSize=tile_grid_size)

    def enhance(self, image_bgr):
        lab = cv2.cvtColor(image_bgr, cv2.COLOR_BGR2LAB)
        l, a, b = cv2.split(lab)
        l_enhanced = self.clahe.apply(l)
        lab_enhanced = cv2.merge((l_enhanced, a, b))
        enhanced_bgr = cv2.cvtColor(lab_enhanced, cv2.COLOR_LAB2BGR)
        return enhanced_bgr

def run_tiled_inference(model, img, tile_rows=2, tile_cols=2, overlap_ratio=0.25, conf=0.25):
    """
    Runs inference on tiles to find SMALL objects.
    """
    h_img, w_img, _ = img.shape
    tile_h = int(h_img / tile_rows)
    tile_w = int(w_img / tile_cols)
    step_h = int(tile_h * (1 - overlap_ratio))
    step_w = int(tile_w * (1 - overlap_ratio))
    
    all_boxes = []
    all_classes = []
    all_confs = []
    
    # Sliding window
    for y in range(0, h_img, step_h):
        for x in range(0, w_img, step_w):
            y2 = min(y + tile_h, h_img)
            x2 = min(x + tile_w, w_img)
            y1 = max(0, y2 - tile_h)
            x1 = max(0, x2 - tile_w)
            
            tile = img[y1:y2, x1:x2]
            results = model(tile, conf=conf, verbose=False, agnostic_nms=True)
            
            for box in results[0].boxes:
                xyxy = box.xyxy[0].cpu().numpy()
                cls = int(box.cls[0].cpu().numpy())
                conf_val = float(box.conf[0].cpu().numpy())
                
                # Filter edge artifacts (Remove objects touching tile edges)
                bx1, by1, bx2, by2 = xyxy
                margin = 5
                if (bx1 < margin and x1 > 0) or (bx2 > (x2-x1)-margin and x2 < w_img) or \
                   (by1 < margin and y1 > 0) or (by2 > (y2-y1)-margin and y2 < h_img):
                   continue 

                global_box = [xyxy[0]+x1, xyxy[1]+y1, xyxy[2]+x1, xyxy[3]+y1]
                all_boxes.append(global_box)
                all_classes.append(cls)
                all_confs.append(conf_val)

    return all_boxes, all_classes, all_confs

def main():
    """
    Main entry point for the Hybrid Object Detection program.
    It uses a Low Light Enhancer to preprocess the image, then runs
    a two-stage object detection system:
    1. Full image pass using standard detection (for big objects)
    2. Tiled pass to detect small objects missed in the full pass
    Finally, it merges results using Non-Maximum Suppression (NMS).
    """
    print("Select Low Light Image...")  
    root = Tk()
    root.withdraw()
    image_path = filedialog.askopenfilename(title="Select Low Light Image")
    if not image_path: return

    print("Loading Model...")
    model = YOLO('yolo11n.pt') 
    
    # Preprocessing
    original = cv2.imread(image_path)
    enhancer = LowLightEnhancer()
    img = enhancer.enhance(original)
    
    # --- STEP 1: Full Image Pass (For BIG objects like Cars, Bottles) ---
    print("1. Running Standard Detection (For Big Context)...")
    results_full = model(img, conf=0.35, iou=0.5, verbose=False) # Higher conf for full image to reduce noise
    
    final_boxes = []
    final_classes = []
    final_confs = []
    
    if len(results_full[0].boxes) > 0:
        for box in results_full[0].boxes:
            final_boxes.append(box.xyxy[0].cpu().numpy())
            final_classes.append(int(box.cls[0].cpu().numpy()))
            final_confs.append(float(box.conf[0].cpu().numpy()))
            
    # --- STEP 2: Tiled Pass (For SMALL objects that were missed) ---
    print("2. Running Tiled Detection (For Small Details)...")
    tiled_boxes, tiled_classes, tiled_confs = run_tiled_inference(model, img, conf=0.25)
    
    # Combine results
    final_boxes.extend(tiled_boxes)
    final_classes.extend(tiled_classes)
    final_confs.extend(tiled_confs)
    
    # --- STEP 3: Merge Duplicates (Global NMS) ---
    print(f"3. Merging Results ({len(final_boxes)} total candidates)...")
    if len(final_boxes) > 0:
        
        # CRITICAL FIX: Convert [x1, y1, x2, y2] to [x, y, w, h] for OpenCV NMS
        boxes_xywh = []
        for box in final_boxes:
            x1, y1, x2, y2 = box
            w = x2 - x1
            h = y2 - y1
            boxes_xywh.append([int(x1), int(y1), int(w), int(h)])
            
        indices = cv2.dnn.NMSBoxes(
            bboxes=boxes_xywh, 
            scores=final_confs, 
            score_threshold=0.25, 
            nms_threshold=0.45 
        )
        
        # Visualization
        img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)
        count = 0
        if len(indices) > 0:
            if isinstance(indices, tuple): indices = indices[0]
            indices = np.array(indices).flatten()
            
            for i in indices:
                idx = int(i)
                x1, y1, x2, y2 = map(int, final_boxes[idx])
                label = f"{model.names[final_classes[idx]]} {final_confs[idx]:.2f}"
                
                # Draw Box
                cv2.rectangle(img_rgb, (x1, y1), (x2, y2), (0, 255, 0), 2)
                cv2.putText(img_rgb, label, (x1, y1-10), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 2)
                count += 1
        
        print(f"Final Count: {count} Objects")
        
        plt.figure(figsize=(10, 8))
        plt.imshow(img_rgb)
        plt.title(f"Hybrid Detection Result: {count} Objects Found\n(Full Context + Tiled Detail)", fontsize=14)
        plt.axis('off')
        plt.show()
    else:
        print("No objects found.")

if __name__ == "__main__":
    main()
